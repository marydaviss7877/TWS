#!/bin/sh
# Blocks staged commits that introduce hardcoded colors instead of using the
# brand token system (frontend/src/design/tokens.js). See
# frontend/scripts/check-brand-colors.js for what's checked.
#
# Enabled via: git config core.hooksPath TWS/frontend/.githooks
# (run once per clone — see frontend/README section on the token system,
# or just re-run that command if this hook isn't firing.)

cd "$(git rev-parse --show-toplevel)/TWS/frontend" || exit 1
npx lint-staged
