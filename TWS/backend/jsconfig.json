{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": [
      "../node_modules/@types",
      "./node_modules/@types"
    ],
    "paths": {
      "@config/*": ["src/config/*"],
      "@models/*": ["src/models/*"],
      "@services/*": ["src/services/*"],
      "@middleware/*": ["src/middleware/*"],
      "@modules/*": ["src/modules/*"],
      "@workers/*": ["src/workers/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src/**/*", "src/types/**/*.d.ts", "server.js"],
  "exclude": ["node_modules", "coverage"]
}
